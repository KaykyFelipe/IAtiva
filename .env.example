# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.
# Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Banco próprio da aplicação (PostgreSQL). Separado do banco do ERP.
IATIVA_DB_NAME=iativa
IATIVA_DB_USER=iativa
IATIVA_DB_PASSWORD=
IATIVA_DB_HOST=127.0.0.1
IATIVA_DB_PORT=5432

# Base sintética que simula o ERP (SQLite, somente leitura para a aplicação).
# Padrão: var/erp_sintetico.sqlite3
IATIVA_SYNTHETIC_ERP_PATH=

# ERP real (SQL Server, login SOMENTE LEITURA). Só no servidor; sem IATIVA_ERP_HOST fica desligado.
# Com HOST preenchido, DATABASE, USER e PASSWORD são obrigatórios.
IATIVA_ERP_HOST=
IATIVA_ERP_PORT=1433
IATIVA_ERP_DATABASE=
IATIVA_ERP_USER=
IATIVA_ERP_PASSWORD=
# yes/no. Certificado autoassinado no SQL Server de homologação: IATIVA_ERP_TRUST_CERT=yes
IATIVA_ERP_ENCRYPT=yes
IATIVA_ERP_TRUST_CERT=no

# Agente. teste = provedor falso, sem IA. gemini = API do Gemini (M10). anthropic = API da Claude.
IATIVA_AGENTE_PROVEDOR=teste
IATIVA_AGENTE_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=
# Gemini: use chave de projeto COM faturamento ativo (no nível gratuito o Google pode usar os dados).
GEMINI_API_KEY=
IATIVA_GEMINI_MODELO=gemini-3.8-flash
# Modelos de reserva (separados por vírgula) quando o principal está sobrecarregado ou no limite.
IATIVA_GEMINI_RESERVA=gemini-3.5-flash
# 1 somente após a posição do DPO/LGPD sobre enviar a pergunta ao provedor (D5/D6).
IATIVA_AGENTE_ENVIO_LIBERADO=0

# M9: 1 permite que quem propôs uma consulta aprendida também a aprove (só se houver um único administrador).
IATIVA_APRENDIZADO_AUTOAPROVACAO=0
