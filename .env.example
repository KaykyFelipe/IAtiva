# Copie para .env e preencha. O arquivo .env NÃO deve ser versionado.
# Gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Banco próprio da aplicação (PostgreSQL). Separado do banco do ERP.
IATIVA_DB_NAME=iativa
IATIVA_DB_USER=iativa
IATIVA_DB_PASSWORD=
IATIVA_DB_HOST=127.0.0.1
IATIVA_DB_PORT=5432

# Base sintética que simula o ERP (SQLite, somente leitura para a aplicação).
# Padrão: var/erp_sintetico.sqlite3
IATIVA_SYNTHETIC_ERP_PATH=

# ERP real (SQL Server, login SOMENTE LEITURA). Só no servidor; sem IATIVA_ERP_HOST fica desligado.
# Com HOST preenchido, DATABASE, USER e PASSWORD são obrigatórios.
IATIVA_ERP_HOST=
IATIVA_ERP_PORT=1433
IATIVA_ERP_DATABASE=
IATIVA_ERP_USER=
IATIVA_ERP_PASSWORD=
# yes/no. Certificado autoassinado no SQL Server de homologação: IATIVA_ERP_TRUST_CERT=yes
IATIVA_ERP_ENCRYPT=yes
IATIVA_ERP_TRUST_CERT=no

# Agente. teste = provedor falso, sem IA. gemini = API do Gemini (M10). openrouter = OpenRouter.
# anthropic = API da Claude.
IATIVA_AGENTE_PROVEDOR=teste
# Claude Code pessoal: selecione claude-code e autentique a CLI no ambiente do Python.
# No Windows, informe o caminho absoluto do claude.exe nativo (não claude.cmd).
IATIVA_CLAUDE_CLI=claude
IATIVA_CLAUDE_CONFIG_DIR=
IATIVA_CLAUDE_MODELO=sonnet
IATIVA_CLAUDE_TIMEOUT_S=120
# Login pela interface: somente superusuários. Opcional: restrinja também por username.
IATIVA_CLAUDE_USUARIO=
# Diretórios exclusivos por usuário; padrão var/claude-pessoal (ignorado pelo Git).
IATIVA_CLAUDE_CONTAS_DIR=
IATIVA_AGENTE_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=
# Gemini: use chave de projeto COM faturamento ativo (no nível gratuito o Google pode usar os dados).
GEMINI_API_KEY=
IATIVA_GEMINI_MODELO=gemini-3.8-flash
# Modelos de reserva (separados por vírgula) quando o principal está sobrecarregado ou no limite.
IATIVA_GEMINI_RESERVA=gemini-3.5-flash
# OpenRouter (IATIVA_AGENTE_PROVEDOR=openrouter). Modelos ":free" têm limite por minuto e o
# provedor pode registrar os dados enviados: mesma pendência do DPO.
OPENROUTER_API_KEY=
IATIVA_OPENROUTER_MODELO=google/gemma-4-26b-a4b-it:free
# Reserva (separados por vírgula) para quando o principal estiver no limite. Vazio = sem reserva.
IATIVA_OPENROUTER_RESERVA=
# 1 = pede raciocínio ao modelo (mais lento, melhor interpretação).
IATIVA_OPENROUTER_RACIOCINIO=1
# 1 somente após a posição do DPO/LGPD sobre enviar a pergunta ao provedor (D5/D6).
IATIVA_AGENTE_ENVIO_LIBERADO=0
# M22 — limites do ciclo do agente por mensagem (opcionais): ações diferentes que ele pode tentar,
# repetições de uma consulta que caiu por erro transitório e tempo total em segundos.
IATIVA_AGENTE_PASSOS=3
IATIVA_AGENTE_RETENTATIVAS=1
IATIVA_AGENTE_TEMPO_S=120

# M9: 1 permite que quem propôs uma consulta aprendida também a aprove (só se houver um único administrador).
IATIVA_APRENDIZADO_AUTOAPROVACAO=0
